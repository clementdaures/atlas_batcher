# Atlas Batcher private settings - TEMPLATE.
# Copy this file to .env (which is git-ignored) and fill in the values.
# Values may be written without quotes; backslashes are kept as they are.
# Set ATLAS_BATCHER_ENV to the path of a .env file to load it from another place.

# --- Tractor ---
TRACTOR_HOST=http://tractor-host
TRACTOR_USER=your-tractor-user
TRACTOR_PASS=your-tractor-password
# Comma separated room numbers used by the blade filter of the Tractor dialog
TRACTOR_ROOMS=01,02,03

# --- Storage ---
ATLAS_SHOT_ROOT=\\server\share\PROJECT\05_SHOT
ATLAS_ASSET_ROOT=\\server\share\PROJECT\04_ASSET

# --- Executables ---
HUSK_PATH=C:\Program Files\Side Effects Software\Houdini 20.5.xxx\bin\husk.exe
HYTHON_PATH=C:\Program Files\Side Effects Software\Houdini 20.5.xxx\bin\hython.exe
TRACTOR_SPOOL_PATH=C:\Program Files\Pixar\Tractor-2.4\bin\tractor-spool.bat

# --- Artists ---
# Comma separated MACHINE_NAME:username pairs
ATLAS_USER_MAP=MACHINE01:username01,MACHINE02:username02
